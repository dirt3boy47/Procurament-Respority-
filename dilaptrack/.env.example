# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables.

# Supabase project URL and publishable (anon) key - Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key (or legacy service_role key). Only needed to invite
# users from the Users page. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of the app, used in invitation and password-reset emails.
# On Vercel this defaults to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown at the top of PDF reports.
NEXT_PUBLIC_PROJECT_NAME=DilapTrack

# Largest file the uploader accepts, in MB. Must not exceed the Supabase
# Storage upload limit (50 MB on the Free plan; raise it on Pro).
NEXT_PUBLIC_MAX_UPLOAD_MB=50
